{{~#if prop.nullable}}
        {{~else}}
        JsonConstraints.checkNotNull("{{prop.name}}", {{param.name}}, call)
        {{~/if}}
        JsonConstraints.{{toTypeCheckMethodName prop.codegenType}}("{{prop.name}}", {{param.name}}, call)?.let {
        {{~#if prop.constraints.size}}
        {{~#each prop.constraints}}
            Constraints.{{name}}("{{../name}}", it, call{{~#if args.size}}, {{#each args}}{{@key}}={{quote .}}, {{/each}}{{/if}})
        {{~/each}}
        {{~/if}}
        }
