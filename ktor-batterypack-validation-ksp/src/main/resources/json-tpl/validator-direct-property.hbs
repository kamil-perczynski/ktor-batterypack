{{~#unless prop.jsonIgnored}}
        {{~#if prop.required}}
        JsonTypeChecks.checkNotNull({{quote prop.jsonName}}, {{param.name}}, call)
        {{~/if}}
        JsonTypeChecks.{{toTypeCheckMethodName prop.codegenType}}({{quote prop.jsonName}}, {{param.name}}, call)?.let {
        {{~#each prop.constraints}}
            {{jsonConstraint constraint=this prop=../jsonName}}
        {{~/each}}
        }
{{/unless}}