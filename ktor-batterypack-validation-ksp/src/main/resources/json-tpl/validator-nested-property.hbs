{{~#unless prop.jsonIgnored}}
        {{~#if prop.required}}
        JsonTypeChecks.checkNotNull({{quote prop.jsonName}}, {{param.name}}, call)
        {{~/if}}
        {{~#if prop.isObject}}
        JsonTypeChecks.checkObject({{quote prop.jsonName}}, {{param.name}}, call)?.let {
            val itemCall = call.nestedProperty({{quote prop.jsonName}})
            {{~#each prop.constraints}}
            {{jsonConstraint constraint=this prop='$' call='itemCall'}}
            {{~/each}}
            {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishObject()
        }
        {{~/if}}
        {{~#if prop.isList}}
        JsonTypeChecks.checkArray({{quote prop.jsonName}}, {{param.name}}, call)?.let {
            val itemCall = call.nestedProperty({{quote prop.jsonName}})
            {{~#each prop.constraints}}
            {{jsonConstraint constraint=this prop='$' call='itemCall'}}
            {{~/each}}
            {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishList()
        }
        {{~/if}}
        {{~#if prop.codegenType.isEnum}}
        {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
        {{this}}({{param.name}}, call, {{quote prop.jsonName}})
        {{~/with}}
        {{~/if}}
{{~/unless}}