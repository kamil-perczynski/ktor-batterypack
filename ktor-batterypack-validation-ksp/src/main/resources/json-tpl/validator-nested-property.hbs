{{~#if prop.nullable}}
        {{~else}}
        JsonConstraints.checkNotNull("{{prop.name}}", {{param.name}}, call)
        {{~/if}}
        {{~#if prop.isObject}}
        JsonConstraints.checkObject("{{prop.name}}", {{param.name}}, call)?.let {
            val itemCall = call.nestedProperty("{{prop.name}}")
            {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishObject()
        }
        {{~/if}}
        {{~#if prop.isList}}
        JsonConstraints.checkArray("{{prop.name}}", {{param.name}}, call)?.let {
            val itemCall = call.nestedProperty("{{prop.name}}")
            {{~#each prop.constraints}}
            {{jsonConstraint constraint=this prop=null call='itemCall'}}
            {{~/each}}
            {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishList()
        }
        {{~/if}}
        {{~#if prop.codegenType.isEnum}}
        {{~#with (findValidationMethod paramType=param.codegenType prop=prop)}}
        {{this}}({{param.name}}, call, "{{prop.name}}")
        {{~/with}}
        {{~/if}}