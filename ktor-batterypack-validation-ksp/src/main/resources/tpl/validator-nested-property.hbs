        {{~#if prop.isObject}}
        {{param.name}}.{{prop.name}}?.let {
            val itemCall = call.nestedProperty("{{prop.name}}")
            {{~#with (findValidationMethod param=param prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishObject()
        }
        {{~/if}}
        {{~#if prop.isList}}
        {{param.name}}.{{prop.name}}?.let {
            val itemCall = call.nestedProperty("{{prop.name}}")
            {{~#each prop.constraints}}
            Constraints.{{name}}("{{../name}}", it, itemCall)
            {{~/each}}
            {{~#with (findValidationMethod param=param prop=prop)}}
            {{this}}(it, itemCall)
            {{~/with}}
            itemCall.finishList()
        }
        {{~/if}}
        {{~#if prop.codegenType.isEnum}}
        {{~#with (findValidationMethod param=param prop=prop)}}
        {{this}}({{param.name}}.{{prop.name}}, call)
        {{~/with}}
        {{~/if}}